{
	"name": "agents-compose",
	"version": "1.0.0",
	"description": "Compose ordinary Markdown documents into a deterministic AGENTS.md.",
	"type": "module",
	"bin": {
		"agents-compose": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema.json": "./schema.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"schema.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
		"build": "bun run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"compose": "bun src/cli.ts build",
		"compose:check": "bun src/cli.ts check",
		"check": "bun run lint && bun run typecheck && bun test && bun run compose:check",
		"prepack": "bun run build"
	},
	"keywords": [
		"agents",
		"agents-md",
		"markdown",
		"cli",
		"ai"
	],
	"author": "yuu1111",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/agents-compose.git"
	},
	"bugs": {
		"url": "https://github.com/yuu1111/agents-compose/issues"
	},
	"homepage": "https://github.com/yuu1111/agents-compose#readme",
	"dependencies": {
		"diff": "^9.0.0",
		"tinyglobby": "^0.2.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@yuu1111/biome-config": "1.0.4",
		"@yuu1111/tsconfig": "1.0.4",
		"tsc-alias": "1.9.1",
		"typescript": "^7.0.2"
	}
}
